      "f_apcp_24h",
      "f_cape",
      "f_hgt_500",
      "f_u_850",
      "f_v_850",
      "lat",
      "lon"
    ],
    "hyperparameters": {
      "n_estimators": 100,
      "max_depth": 5,
      "learning_rate": 0.1,
      "random_state": 42,
      "tree_method": "hist"
    }
  },
