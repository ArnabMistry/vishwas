# ==============================================================================
# VISHWAS: Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local if custom environment overrides are needed.
# NOTE: The default local evaluation prototype requires ZERO configuration or keys.
# ==============================================================================

# [Frontend - Optional Local Overrides]
# Base URL for the FastAPI backend service proxy
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PORT=3000

# [Backend - Optional Local Overrides]
# Backend listening port
BACKEND_PORT=8000

# ==============================================================================
# [Production Deployment Only - Not needed for local evaluation / demo]
# ==============================================================================
# NCMRWF_GRIB_DATA_STREAM_URL=ftp://ncmrwf-internal.moes.gov.in/ncum_global/
# NCMRWF_FTP_USER=your_operational_user
# NCMRWF_FTP_PASSWORD=your_operational_password
#
# IMD_RADAR_API_KEY=your_imd_dwr_access_token
# DATABASE_URL=postgresql://user:password@localhost:5432/vishwas_db
# SENTRY_DSN=https://your_key@sentry.io/project_id
